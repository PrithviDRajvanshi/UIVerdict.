datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum AnalysisStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  passwordHash String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  projects     Project[]
  analyses     Analysis[]

  @@map("users")
}

model Project {
  id        String     @id @default(uuid())
  userId    String?
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String     @default("Default Project")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  analyses  Analysis[]

  @@index([userId])
  @@map("projects")
}

model Analysis {
  id                     String         @id @default(uuid())
  projectId              String
  project                Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId                 String?
  user                   User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  url                    String
  status                 AnalysisStatus @default(PENDING)

  // Overall UIVerdict scoring
  overallScore           Float?
  verdictLabel           String?

  // Lighthouse score scalars (0-100)
  performanceScore       Int?
  accessibilityScore     Int?
  bestPracticesScore     Int?
  seoScore               Int?

  // Core Web Vitals & diagnostic display metrics
  firstContentfulPaint   String?
  largestContentfulPaint String?
  speedIndex             String?
  totalBlockingTime      String?
  cumulativeLayoutShift  String?
  timeToInteractive      String?

  // Variable & structured AI analysis data (stored as JSON)
  qualitativeCritique    Json?
  strengths              Json?
  areasForRefinement     Json?

  // Sanitized per-run capture and audit diagnostics; no page body or browser credentials.
  playwrightDiagnostics  Json?
  lighthouseDiagnostics Json?
  screenshotArtifactName String? @db.VarChar(200)
  screenshotSha256       String? @db.Char(64)

  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  @@index([projectId])
  @@index([userId])
  @@index([url])
  @@index([status])
  @@index([overallScore])
  @@index([createdAt])
  @@map("analyses")
}


