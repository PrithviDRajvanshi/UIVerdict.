datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum AnalysisStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  passwordHash String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  projects     Project[]
  analyses     Analysis[]

  @@map("users")
}

model Project {
  id        String     @id @default(uuid())
  userId    String?
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String     @default("Default Project")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  analyses  Analysis[]

  @@index([userId])
  @@map("projects")
}

model Analysis {
  id              String         @id @default(uuid())
  projectId       String
  project         Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId          String?
  user            User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  url             String
  status          AnalysisStatus @default(PENDING)
  mongoDocumentId String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([projectId])
  @@index([userId])
  @@index([url])
  @@index([status])
  @@index([createdAt])
  @@map("analyses")
}


