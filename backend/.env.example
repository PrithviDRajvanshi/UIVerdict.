PORT=3000
NODE_ENV=development
JWT_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.8-flash
GEMINI_LAST_FALLBACK_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_MS=25000
GEMINI_DEADLINE_MS=45000
GEMINI_MAX_ATTEMPTS=2
# Development only: opt into retaining new uiverdict-prefixed screenshots for up to 168 hours; zero cleans immediately.
# Expired managed files are pruned during a later capture; legacy filenames are never included in cleanup.
UIVERDICT_DEV_SCREENSHOT_RETENTION_HOURS=0
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/uiverdict?schema=public
